{
  "schema": 1,
  "id": "dantzig",
  "name": "Dantzig's Hoard",
  "purpose": "Native resource scheduling and product configuration with explicit constraints and verified results.",
  "capabilities": [
    "resource-scheduling",
    "alternative-resources",
    "precedence",
    "deadlines",
    "family-change-gaps",
    "verified-schedules",
    "persistent-problems",
    "product-configuration",
    "compatibility-propagation",
    "minimal-repair",
    "conflict-explanation",
    "bill-of-materials",
    "planning-editor",
    "schedule-comparison",
    "schedule-timeline",
    "problem-validation"
  ],
  "placeholders": [
    "DANTZIG_DIR",
    "PYTHON",
    "APP_URL"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5241",
    "PYTHON": "{DANTZIG_DIR}/.venv/Scripts/python.exe"
  },
  "app": {
    "url_default": "http://127.0.0.1:5241",
    "ui_url": "{APP_URL}/",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "dantzig-hoard"
      }
    },
    "launch_hint": {
      "kind": "process",
      "executable": "{PYTHON}",
      "argv": [
        "-m",
        "dantzig"
      ],
      "cwd": "{DANTZIG_DIR}",
      "readiness": {
        "url": "{APP_URL}/api/health",
        "timeout_s": 20
      },
      "port_argument": "--port"
    },
    "identify": {
      "service": [
        "dantzig-hoard"
      ],
      "title": [
        "dantzig"
      ]
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "-m",
      "dantzig.mcp_server"
    ],
    "env": {
      "PYTHONPATH": "{DANTZIG_DIR}",
      "DANTZIG_DATA": "{DANTZIG_DIR}/data"
    }
  },
  "notes": "Explicit startup only. MCP stdio uses the shared native service; discovery starts no app. Copilot uses the canonical family relay, without a separate conversation loop. Planner and family integration candidates awaiting review; configurator has requested changes.",
  "x-family": {
    "copilot": {
      "contract_version": "1.0",
      "info": "/api/copilot/info",
      "panel": "/api/copilot/panel.js",
      "proxy": "/api/copilot/proxy",
      "launcher": "/api/copilot/launcher.js"
    },
    "agent_contract": false
  }
}
